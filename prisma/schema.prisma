generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL") 
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  username         String
  email            String   @unique
  password         String  
  role             String   @default("customer") 
  createdAt        DateTime @default(now())
  tempPasswordHash String?  
}

model Product {
  id          Int      @id @map("_id") 
  name        String
  description String
  price       Float
  stock       Int
  category    String
  flavor      String?
  image       String
  createdAt   DateTime @default(now())
}

