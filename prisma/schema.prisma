generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL") 
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  username         String
  email            String   @unique
  password         String  
  role             String   @default("customer") 
  createdAt        DateTime @default(now())
  tempPasswordHash String?  
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId // Add @default(auto()) and @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  products  Product[]
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId // Also fix this for consistency
  name        String
  description String
  price       Float
  stock       Int
  categoryId  String?  @db.ObjectId // Add @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
  flavor      String?
  image       String
  createdAt   DateTime @default(now())
}


