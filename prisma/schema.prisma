generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL") // Uses the MongoDB URL from .env file
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String   @unique
  password  String
  role      String   @default("customer") // "admin" or "customer"
  createdAt DateTime @default(now())
}

